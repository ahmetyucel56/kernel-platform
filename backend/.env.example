# ---------------------------------------------------------------------------
# Kernel backend ortam degiskenleri.
# Bu dosyayi ".env" olarak kopyalayin ve degerleri doldurun.
# ---------------------------------------------------------------------------

# Marka adi tek yerden yonetilir (Bolum 8.5). Kesin isim belirlenince burayi degistirin.
BRAND_NAME=Kernel

# --- Veritabani -------------------------------------------------------------
# Bos birakilirsa yerel SQLite kullanilir (kurulum gerektirmez, hemen calisir):
#   sqlite:///./kernel.db
#
# Supabase / Postgres icin:
# ONEMLI: Render gibi IPv4 host'larda "Direct connection" (db.<ref>.supabase.co)
# CALISMAZ (IPv6). Bunun yerine "Session pooler" dizesini kullan (Supabase >
# Project Settings > Database > Connection string > Session pooler):
#   postgresql+psycopg://postgres.<ref>:<PAROLA>@aws-0-<region>.pooler.supabase.com:5432/postgres
# (Basindaki "postgresql://" ifadesini "postgresql+psycopg://" ile degistir.)
DATABASE_URL=sqlite:///./kernel.db

# Baslangicta eksik tablolari otomatik olustur (demo icin pratik).
AUTO_CREATE_TABLES=true
# Baslangicta ornek hesaplari olustur (SADECE demo deploy'da true yap).
SEED_ON_START=false

# --- Kimlik dogrulama (Auth) ------------------------------------------------
# local    -> platformun kendi JWT'si (Supabase hesabi gerektirmez, gelistirme icin)
# supabase -> Supabase Auth JWT'lerini dogrular (ileride)
AUTH_PROVIDER=local
JWT_SECRET=degistir-bu-degeri-uzun-rastgele-bir-anahtarla
JWT_EXPIRES_MINUTES=10080

# Supabase (Storage icin URL + SERVICE_KEY; Auth icin ileride digerleri):
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role anahtari GIZLIDIR: yalnizca sunucu ortaminda (Render paneli) tutulur.
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# --- Dosya depolama (Storage) ----------------------------------------------
# Ogrencinin yukledigi orijinal ZIP (hoca/ogrenci "Projeyi indir" ile alir).
# local    -> STORAGE_DIR altinda (gelistirme; Render'da disk gecicidir)
# supabase -> Supabase Storage, OZEL bucket (yoksa ilk yuklemede olusturulur).
#             SUPABASE_URL + SUPABASE_SERVICE_KEY gerekir.
# Depolama yoksa/erisilemezse indirme, DB'deki iceriklerden yeniden paketlenir.
STORAGE_PROVIDER=local
STORAGE_DIR=./storage
STORAGE_BUCKET=submissions

# --- Yapay zeka (Bolum 3/7 — tek servis katmani, provider/model config'ten) --
# provider: anthropic | mock (mock, API anahtari olmadan sahte cevap uretir)
AI_PROVIDER=mock
AI_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=

# --- CORS -------------------------------------------------------------------
# Virgulle ayrilmis izinli frontend origin'leri
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
